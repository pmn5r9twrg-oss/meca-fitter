<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mecafitter | Field Pipefitting Tools</title>
<style>
:root{--bg:#0b1014;--panel:#111b22;--panel2:#16242d;--line:#29414d;--text:#edf5f7;--muted:#a3b6be;--orange:#f39a32;--orange2:#ffb65b;--good:#6cd4a2;--danger:#ff7474}
*{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at 20% 0,#19313a 0,#0b1014 42%);color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}
header{border-bottom:1px solid var(--line);background:rgba(10,16,20,.94);position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.top{max-width:1200px;margin:auto;min-height:78px;padding:12px 20px;display:flex;align-items:center;gap:15px}.brand{display:flex;align-items:center;gap:12px;min-width:200px}.logo{width:52px;height:45px;display:block}.brand h1{font-size:1.3rem;letter-spacing:.07em;text-transform:uppercase;margin:0}.brand small{display:block;color:var(--orange2);font-weight:700;font-size:.67rem;letter-spacing:.1em;margin-top:2px}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-left:auto}.tab{border:1px solid transparent;background:transparent;color:var(--muted);padding:10px 12px;border-radius:8px;cursor:pointer;font-weight:750}.tab:hover{color:var(--text);background:#17242c}.tab.active{background:var(--orange);color:#181105;border-color:var(--orange2)}
main{max-width:1200px;margin:auto;padding:28px 20px 50px}.intro{margin:0 0 25px}.intro h2{margin:0 0 7px;font-size:clamp(1.6rem,3vw,2.2rem)}.intro p{margin:0;color:var(--muted);line-height:1.5}.view{display:none}.view.active{display:block}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{grid-column:span 6;background:linear-gradient(145deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 16px 35px #0002}.card.wide{grid-column:span 12}.card h3{margin:0 0 5px;font-size:1.2rem}.description{color:var(--muted);font-size:.92rem;margin:0 0 18px;line-height:1.45}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.fields.three{grid-template-columns:repeat(3,minmax(0,1fr))}label{display:block;color:#c2d1d6;font-size:.79rem;font-weight:750;margin-bottom:6px;letter-spacing:.02em}input,select{width:100%;color:var(--text);background:#0b1217;border:1px solid #37515d;border-radius:8px;padding:10px;font:inherit;outline:none}input:focus,select:focus{border-color:var(--orange);box-shadow:0 0 0 3px #f39a3226}button.calc{border:0;border-radius:8px;background:var(--orange);color:#211405;font-weight:850;padding:11px 15px;cursor:pointer;margin-top:17px}button.calc:hover{background:var(--orange2)}.result{margin-top:17px;padding:14px;border-radius:9px;background:#091116;border-left:4px solid var(--orange)}.result .big{font-size:1.45rem;font-weight:850;color:var(--orange2)}.result p{color:var(--muted);margin:7px 0 0;line-height:1.45;font-size:.9rem}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px}.metric{padding:10px;background:#132128;border:1px solid #2b434d;border-radius:7px}.metric span{display:block;font-size:.72rem;color:var(--muted)}.metric strong{display:block;margin-top:3px;color:var(--orange2)}.cutrow{display:grid;grid-template-columns:1fr 1fr 1fr 40px;gap:9px;align-items:end;margin:8px 0}.remove{height:40px;border:1px solid #754040;background:#321d20;color:#ff9c9c;border-radius:8px;cursor:pointer}.secondary{border:1px solid #42606a;background:#18272e;color:var(--text);font-weight:750;border-radius:8px;padding:10px 13px;cursor:pointer;margin-top:12px}.table{width:100%;border-collapse:collapse;margin-top:14px}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left}.table th{font-size:.74rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.table td{font-size:.92rem}.note{margin-top:14px;color:var(--muted);font-size:.82rem;line-height:1.45}.footer{max-width:1200px;padding:0 20px 28px;margin:auto;color:#78909a;font-size:.8rem}.hidden{display:none}@media(max-width:760px){.top{align-items:flex-start;flex-wrap:wrap}.tabs{margin-left:0}.card,.card.wide{grid-column:span 12}.fields.three{grid-template-columns:1fr}.result-grid{grid-template-columns:1fr}.cutrow{grid-template-columns:1fr 1fr 40px}.cutrow .cut-qty{grid-column:1/3}}
</style>
</head>
<body>
<header><div class="top"><div class="brand"><svg class="logo" viewBox="0 0 120 100" role="img" aria-label="Two offset pipes logo"><g fill="none" stroke="#f39a32" stroke-width="13" stroke-linecap="square" stroke-linejoin="round"><path d="M9 19h31l38 56h33"/><path d="M9 80h29L76 24h35"/></g><g fill="none" stroke="#edf5f7" stroke-width="3" opacity=".8"><path d="M40 19l38 56M38 80l38-56"/></g></svg><div><h1>Mecafitter</h1><small>Field Tools for Pipefitters</small></div></div><nav class="tabs"><button class="tab active" data-view="offsets">Offsets</button><button class="tab" data-view="cutpieces">Cut Pieces</button><button class="tab" data-view="fittings">Fittings</button><button class="tab" data-view="reference">Reference</button></nav></div></header>
<main>
<section id="offsets" class="view active"><div class="intro"><h2>Offset Calculators</h2><p>Use decimal inches or common fractions such as <b>7 1/2</b>, <b>3/4</b>, or <b>12.375</b>. Results are field dimensions; confirm takeouts against the actual fitting manufacturer and specification.</p></div><div class="grid">
<article class="card"><h3>Simple Offset</h3><p class="description">Calculate travel from a single offset and fitting angle. Add your two fitting takeouts to get the cut-piece length.</p><div class="fields"><div><label for="simpleOffset">Offset / Set (in.)</label><input id="simpleOffset" inputmode="decimal" value="12"></div><div><label for="simpleAngle">Angle</label><select id="simpleAngle"><option value="22.5">22.5°</option><option value="30">30°</option><option value="45" selected>45°</option><option value="60">60°</option></select></div><div><label for="simpleT1">Fitting takeout 1 (in.)</label><input id="simpleT1" inputmode="decimal" value="0"></div><div><label for="simpleT2">Fitting takeout 2 (in.)</label><input id="simpleT2" inputmode="decimal" value="0"></div></div><button class="calc" onclick="simpleOffsetCalc()">Calculate Simple Offset</button><div id="simpleResult" class="result">Enter dimensions and calculate.</div></article>
<article class="card"><h3>Rolling Offset</h3><p class="description">Find true offset and travel from separate horizontal and vertical changes. The angle is measured from the run line.</p><div class="fields"><div><label for="rollH">Horizontal offset (in.)</label><input id="rollH" inputmode="decimal" value="12"></div><div><label for="rollV">Vertical offset (in.)</label><input id="rollV" inputmode="decimal" value="9"></div><div><label for="rollAngle">Fitting angle</label><select id="rollAngle"><option value="22.5">22.5°</option><option value="30">30°</option><option value="45" selected>45°</option><option value="60">60°</option></select></div><div><label for="rollT">Total takeout (in.)</label><input id="rollT" inputmode="decimal" value="0"></div></div><button class="calc" onclick="rollingOffsetCalc()">Calculate Rolling Offset</button><div id="rollResult" class="result">Enter dimensions and calculate.</div></article>
<article class="card wide"><h3>Quick multipliers</h3><p class="description">Travel = offset × multiplier. These are ideal values for standard simple offsets.</p><table class="table"><thead><tr><th>Angle</th><th>Travel multiplier</th><th>Advance multiplier</th></tr></thead><tbody><tr><td>22.5°</td><td>2.613</td><td>2.414</td></tr><tr><td>30°</td><td>2.000</td><td>1.732</td></tr><tr><td>45°</td><td>1.414</td><td>1.000</td></tr><tr><td>60°</td><td>1.155</td><td>0.577</td></tr></tbody></table><p class="note">Advance is the distance along the original run corresponding to the offset. For rolling offsets, calculate the true offset first.</p></article>
</div></section>
<section id="cutpieces" class="view"><div class="intro"><h2>Cut Piece List</h2><p>Build a quick field cut list. The app totals the requested finished cut lengths; add takeout values in the description or calculate them in the fitting tool first.</p></div><div class="grid"><article class="card wide"><h3>Job cut list</h3><div id="cutRows"></div><button class="secondary" onclick="addCutRow()">+ Add Cut Piece</button><button class="calc" onclick="totalCuts()">Total Cut List</button><div id="cutResult" class="result">Add cut pieces to build a total.</div><p class="note">Cut length is the finished piece length. This does not automatically add kerf, root-face, bevel, or trim allowance.</p></article></div></section>
<section id="fittings" class="view"><div class="intro"><h2>Fitting & Cut Length</h2><p>Calculate a straight cut piece between two fitting centerlines by subtracting each fitting takeout.</p></div><div class="grid"><article class="card"><h3>Center-to-center cut piece</h3><p class="description">A practical field calculation: center-to-center minus Takeout A minus Takeout B equals the straight piece to cut.</p><div class="fields"><div><label for="cc">Center-to-center (in.)</label><input id="cc" inputmode="decimal" value="48"></div><div><label for="fitA">Fitting A takeout (in.)</label><input id="fitA" inputmode="decimal" value="3"></div><div><label for="fitB">Fitting B takeout (in.)</label><input id="fitB" inputmode="decimal" value="3"></div><div><label for="trim">Trim / allowance (in.)</label><input id="trim" inputmode="decimal" value="0"></div></div><button class="calc" onclick="cutPieceCalc()">Calculate Cut Piece</button><div id="fitResult" class="result">Enter centerline distance and takeouts.</div></article>
<article class="card"><h3>Common 90° elbow centers</h3><p class="description">Reference only. Center-to-face dimensions differ by fitting type, standard, material, schedule, and manufacturer—verify against your actual fitting table.</p><table class="table"><thead><tr><th>NPS</th><th>LR 90° center-to-face</th><th>SR 90° center-to-face</th></tr></thead><tbody><tr><td>1 in.</td><td>1.50 in.</td><td>1.00 in.</td></tr><tr><td>2 in.</td><td>3.00 in.</td><td>2.00 in.</td></tr><tr><td>3 in.</td><td>4.50 in.</td><td>3.00 in.</td></tr><tr><td>4 in.</td><td>6.00 in.</td><td>4.00 in.</td></tr><tr><td>6 in.</td><td>9.00 in.</td><td>6.00 in.</td></tr></tbody></table></article></div></section>
<section id="reference" class="view"><div class="intro"><h2>Field Reference</h2><p>Useful shop-floor conversions and reminders.</p></div><div class="grid"><article class="card"><h3>Fraction / decimal converter</h3><div class="fields"><div><label for="fractionIn">Fraction or mixed inch</label><input id="fractionIn" placeholder="Example: 7 3/8"></div><div><label for="decimalIn">Decimal inch</label><input id="decimalIn" placeholder="Example: 7.375"></div></div><button class="calc" onclick="convertFraction()">Convert</button><div id="convertResult" class="result">Enter either field, then convert.</div></article><article class="card"><h3>Use it safely</h3><p class="description">Mecafitter is a field-aid tool, not a substitute for drawings, specifications, welding procedures, fit-up requirements, or manufacturer data.</p><p class="note">Always verify center-to-face, face-to-face, socket depth, thread engagement, weld gap, material allowances, and the intended datum before cutting.</p></article></div></section>
</main><div class="footer">Mecafitter • Built for fast field layout • Values shown in inches unless noted</div>
<script>
const $=id=>document.getElementById(id);
function parseIn(v){v=String(v??'').trim();if(!v)return 0;let s=v.match(/^(-?\d+)\s+(\d+)\s*\/\s*(\d+)$/);if(s)return Number(s[1])+(Number(s[1])<0?-1:1)*Number(s[2])/Number(s[3]);let f=v.match(/^(-?\d*)\s*\/\s*(\d+)$/);if(f)return Number(f[1]||1)/Number(f[2]);let n=Number(v);return Number.isFinite(n)?n:NaN}
function fmt(n){if(!Number.isFinite(n))return '—';let sign=n<0?'-':'';n=Math.abs(n);let whole=Math.floor(n+1e-8), frac=n-whole;let den=16,num=Math.round(frac*den);if(num===den){whole++;num=0}if(!num)return sign+whole+' in.';let g=(a,b)=>b?g(b,a%b):a;let d=g(num,den);return sign+(whole?whole+' ':'')+(num/d)+'/'+(den/d)+' in. ('+(sign+n).toFixed(3)+' in.)'}
function num(id){return parseIn($(id).value)}
function simpleOffsetCalc(){let o=num('simpleOffset'),a=Number($('simpleAngle').value),t1=num('simpleT1'),t2=num('simpleT2');let rad=a*Math.PI/180,travel=o/Math.sin(rad),advance=o/Math.tan(rad),cut=travel-t1-t2;$('simpleResult').innerHTML=`<div class="big">Travel: ${fmt(travel)}</div><div class="result-grid"><div class="metric"><span>Advance</span><strong>${fmt(advance)}</strong></div><div class="metric"><span>Fitting takeouts</span><strong>${fmt(t1+t2)}</strong></div><div class="metric"><span>Cut piece</span><strong>${fmt(cut)}</strong></div></div><p>Formula: travel = offset ÷ sin(${a}°). Cut piece = travel − combined takeout.</p>`}
function rollingOffsetCalc(){let h=num('rollH'),v=num('rollV'),a=Number($('rollAngle').value),t=num('rollT'),trueO=Math.hypot(h,v),rad=a*Math.PI/180,travel=trueO/Math.sin(rad),advance=trueO/Math.tan(rad),cut=travel-t;$('rollResult').innerHTML=`<div class="big">True offset: ${fmt(trueO)}</div><div class="result-grid"><div class="metric"><span>Travel</span><strong>${fmt(travel)}</strong></div><div class="metric"><span>Advance</span><strong>${fmt(advance)}</strong></div><div class="metric"><span>Cut piece</span><strong>${fmt(cut)}</strong></div></div><p>True offset = √(horizontal² + vertical²). Travel = true offset ÷ sin(${a}°).</p>`}
function cutPieceCalc(){let cc=num('cc'),a=num('fitA'),b=num('fitB'),tr=num('trim'),x=cc-a-b+tr;$('fitResult').innerHTML=`<div class="big">Cut length: ${fmt(x)}</div><p>${fmt(cc)} center-to-center − ${fmt(a+b)} fitting takeouts + ${fmt(tr)} allowance.</p>`}
let cutIndex=0;function addCutRow(name='',length='',qty=1){cutIndex++;let d=document.createElement('div');d.className='cutrow';d.innerHTML=`<div><label>Piece / description</label><input class="cut-name" value="${name}" placeholder="Example: 2 in. 45° offset spool"></div><div><label>Cut length (in.)</label><input class="cut-length" inputmode="decimal" value="${length}" placeholder="Example: 36 1/2"></div><div class="cut-qty"><label>Qty.</label><input class="cut-qty-input" inputmode="numeric" type="number" min="1" value="${qty}"></div><button class="remove" title="Remove piece" onclick="this.parentElement.remove()">×</button>`;$('cutRows').appendChild(d)}
function totalCuts(){let rows=[...document.querySelectorAll('.cutrow')],total=0,pieces=0;rows.forEach(r=>{let l=parseIn(r.querySelector('.cut-length').value),q=Number(r.querySelector('.cut-qty-input').value)||0;if(Number.isFinite(l)){total+=l*q;pieces+=q}});$('cutResult').innerHTML=`<div class="big">Total straight pipe: ${fmt(total)}</div><p>${pieces} piece${pieces===1?'':'s'} in the active cut list. Add kerf, trim, and job-specific allowance before cutting stock.</p>`}
function convertFraction(){let f=$('fractionIn').value.trim(),d=$('decimalIn').value.trim(),n=f?parseIn(f):parseIn(d);$('convertResult').innerHTML=Number.isFinite(n)?`<div class="big">${fmt(n)}</div><p>Decimal: ${n.toFixed(4)} in.</p>`:'<div class="big">Check the value entered.</div>'}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tab,.view').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.view).classList.add('active')}));addCutRow('Example spool piece','36 1/2',1);simpleOffsetCalc();rollingOffsetCalc();cutPieceCalc();
</script>
</body></html>